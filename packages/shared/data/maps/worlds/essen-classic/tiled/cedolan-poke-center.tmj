        {
          "height": 32,
          "id": 5,
          "name": "Bill",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 384,
          "y": 160,
          "properties": [
            {
              "name": "npcId",
              "type": "string",
              "value": "bill"
            },
            {
              "name": "sprite",
              "type": "string",
              "value": "citizen"
            },
            {
              "name": "trainer",
              "type": "bool",
              "value": false
            },
            {
              "name": "originalId",
              "type": "int",
              "value": 5
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "Bill: Hello! I'm .\nI invented the Pok\u00e9mon Storage System.\nWhat do you want to know?\nAll storage box wallpapers need to be listed in\nclass PokemonStorage, in def allWallpapers.\nThey correspond to box_0.png, box_1.png, etc. in\norder without gaps. These images are in the folder\nGraphics/Pictures/Storage.\nStorage wallpapers are split into two categories:\nbasic and special.All basic wallpapers are listed\nbefore the special wallpapers.\nBasic wallpapers are always accessible, and\nboxes use these wallpapers by default. Numbers 0\nto 15 inclusive are basic wallpapers.\nSpecial wallpapers start off locked and unavailable.\nYou can unlock them with pbUnlockWallpaper(id),\nwhere id is the wallpaper's number."
            }
          ]
        },

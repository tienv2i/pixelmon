#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pm.config - cấu hình cho process manager (scripts/pm.sh)
# Nạp tự động bởi pm.sh, có thể override bằng biến môi trường.
# ---------------------------------------------------------------------------

# Thư mục gốc project (pm.sh tự suy ra nếu để trống)
PM_ROOT="${PM_ROOT:-}"

# Node version cần dùng (qua fnm). Để trống = dùng node hiện tại của shell.
PM_NODE_VERSION="${PM_NODE_VERSION:-20}"

# Thư mục lưu PID + log
PM_STATE_DIR="${PM_STATE_DIR:-.pm}"
PM_LOG_DIR="${PM_LOG_DIR:-.pm/logs}"

# Cổng của từng service (dùng để force free port khi start/restart)
PM_SERVER_PORT="${PM_SERVER_PORT:-2567}"
PM_CLIENT_PORT="${PM_CLIENT_PORT:-5173}"

# Lệnh chạy từng service. Dùng `pnpm --filter <pkg> dev` để khỏi qua turbo.
PM_SERVER_CMD="${PM_SERVER_CMD:-pnpm --filter server dev}"
PM_CLIENT_CMD="${PM_CLIENT_CMD:-pnpm --filter client dev}"

# Số giây chờ port mở sau khi start (chờ process "ổn định")
PM_READY_TIMEOUT="${PM_READY_TIMEOUT:-60}"

# Số giây chờ process thoát trước khi SIGKILL
PM_STOP_TIMEOUT="${PM_STOP_TIMEOUT:-8}"

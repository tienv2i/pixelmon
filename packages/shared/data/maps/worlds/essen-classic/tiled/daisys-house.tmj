            },
            {
              "name": "originalId",
              "type": "int",
              "value": 5
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "Hi! I'm the Contest Lady!\nI give out contest ribbons. Do you want one?\nSorry, your  already has the highest ranked\nCool Ribbon.\nN received the .\nN put the  on .\nThat's your choice."
            }
          ]
        },
        {
          "height": 32,
          "id": 6,
          "name": "Stats judge",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 256,
          "y": 128,
          "properties": [
            {
              "name": "npcId",
              "type": "string",
              "value": "stats_judge"
            },
            {
              "name": "sprite",
              "type": "string",
              "value": "citizen"
            },
            {
              "name": "trainer",
              "type": "bool",
              "value": false
            },
            {
              "name": "originalId",
              "type": "int",
              "value": 6
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "If you'd like, I could judge the intriguing potential of\nyour Pok\u00e9mon.\nWhich Pok\u00e9mon would you like me to judge?\n...Oh? You don't need me to judge. I get it.\nI see, I see...\nThis Pok\u00e9mon's potential is outstanding overall.\nThis Pok\u00e9mon's potential is relatively superior\noverall.\nThis Pok\u00e9mon's potential is above average overall.\nThis Pok\u00e9mon's potential is decent overall.\nThat's my determination, and it's final.\nIncidentally, I would say the best potential lies in its\nstat.\nAnd its Attack stat is also good.\nI see, its Defense stat is also good.\nWell, its Speed stat is also good.\nIts Special Attack stat is equally good.\nIts Special Defense stat is good as well.\nIt can't be better in that regard. That's how I judged\nit.\nIt's fantastic in that regard. That's how I judged it.\nIt's very good in that regard. That's how I judged it.\nIt's rather decent in that regard. That's how I judged\nit.\n...Oh? You don't need me to judge. I get it."
            }
          ]
        }
      ],

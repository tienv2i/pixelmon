        {
          "height": 32,
          "id": 2,
          "name": "Nurse",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 224,
          "y": 64,
          "properties": [
            {
              "name": "npcId",
              "type": "string",

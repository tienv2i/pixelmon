              "value": false
            },
            {
              "name": "originalId",
              "type": "int",
              "value": 4
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "Oh?Your ...\nOh! Your , that Effort Ribbon looks good on it!\nWent for it stupendously!\nAs its reward, please give it this Effort Ribbon.\nN received the Effort Ribbon.\nN put the Effort Ribbon on .\nYou have to go for it a little harder.\nIf you do, I'll give your Pok\u00e9mon something nice."
            }
          ]
        },
        {
          "height": 32,
          "id": 5,
          "name": "Contest ribbon giver",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 96,
          "y": 128,
          "properties": [
            {

        {
          "height": 32,
          "id": 17,
          "name": "Lottery",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 288,
          "y": 64,
          "properties": [
            {

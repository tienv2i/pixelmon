        {
          "height": 32,
          "id": 12,
          "name": "Choices NPC",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 288,
          "y": 224,
          "properties": [
            {
              "name": "npcId",
              "type": "string",
              "value": "choices_npc"
            },
            {
              "name": "sprite",
              "type": "string",
              "value": "citizen"
            },
            {
              "name": "trainer",
              "type": "bool",
              "value": false
            },
            {
              "name": "originalId",
              "type": "int",
              "value": 12
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "I will offer you more than 4 choices at once. You\ncan put multiple \"Show Choices\" commands in a row\nto do this.\nPlease choose one.\nChoice 1 was chosen.\nChoice 2 was chosen.\nChoice 3 was chosen.\nChoice 4 was chosen.\nChoice 5 was chosen.\nChoice 6 was chosen.\nChoice 7 was chosen.\nThe choice was cancelled.\nPlease choose one. This choice can't be cancelled.\nChoice 1 was chosen.\nChoice 2 was chosen.\nChoice 3 was chosen.\nChoice 4 was chosen.\nChoice 5 was chosen.\nChoice 6 was chosen.\nChoice 7 was chosen.\nPlease choose one. Cancelling will result in Choice\n3.\nChoice 1 was chosen.\nChoice 2 was chosen.\nChoice 3 was chosen.\nChoice 4 was chosen.\nChoice 5 was chosen.\nChoice 6 was chosen.\nChoice 7 was chosen.\nThis is an example of how to modify choices, using\nthe hide_choice and rename_choice scripts.\nThis choice was renamed by rename_choice.\nThis choice is hidden if the player is not male.\nThis choice is hidden if the player is not female."
            }
          ]
        },
        {
          "height": 32,
          "id": 13,
          "name": "Text formatting NPC",
          "point": false,
          "rotation": 0,
          "type": "npc_spawn",
          "visible": true,
          "width": 32,
          "x": 320,
          "y": 224,
          "properties": [
            {
              "name": "npcId",
              "type": "string",
              "value": "text_formatting_npc"
            },
            {
              "name": "sprite",
              "type": "string",
              "value": "citizen"
            },
            {
              "name": "trainer",
              "type": "bool",
              "value": false
            },
            {
              "name": "originalId",
              "type": "int",
              "value": 13
            },
            {
              "name": "dialog",
              "type": "string",
              "value": "Choose a text option.\nThis is the text of a male character.\nThis is the text of a female character.\ngThis text is the colour of the player's gender.\nogThis text is the colour of the opposite gender to\nthe player.\nDefault, blue, red, green, cyan,\nmagenta, yellow, grey, white,\npurple, orange, dark, light.\n<b>Bold text,</b> <i>italic text,</i> <u>underlined\ntext,</u> <s>strikethrough text,</s> <outln>outline\ntext,</outln> <outln2>thicker outline text.</outln2>\n<fn=Power Clear Bold>Power Clear Bold text,</fn>\n<fs=25>size 25 text,</fs> <fs=40>size 40 text,</fs>\n<o=128>half-transparent text.</o>\nThis is a line break. Text is <r>right-aligned until\nnext line break. Text is <ac>centred</ac> here.\nText is <ar>right-aligned</ar> here.\nN is the player's name, M is the player's money,\nis the content of Game Variable 12.\nThis is <icon=bagPocket3> bagPocket3 from the\nfolder Graphics/Icons. Icons shown this\nway are not padded.\nThe money window is shown.\nNThe coins window is shown.\nNThe money and coins windows are both\nshown. The coins window must be shown second.\nThe introBoy picture from the\nGraphics/Pictures folder is shown.\nThe introBoy picture is shown again, but\ncropped to the top-left 96x96 pixels of it.\nThe windowskin has changed to\n\"signskin\" here.\nThis message box has 3 lines to it rather than 2,\nso more text can be shown at once. Lorem ipsum\ndolor sit amet, consectetur adipisicing elit.\nuThis message box is at the top.\nmThis message box is in the middle.\nuThis message box ism jumping around the\nscreend in a rather off-putting way.\npThis message box slides on-screen at the start.\nlThis message box slides off-screen at the end.\nThis text appeared instantly!\nThis text is slow to appear.\nSlow text speed is 4, normal speed is 2, fast speed\nis 1. It takes this many 1/80ths of a second for the\nnext character in a message to appear.\nSound effect \"Pkmn move\nlearnt\" was played.\nMusic effect \"Item get\" will be played.\nA complete list of all message options is available on\nthe wiki."
            }
          ]
        },

{
  "name": "@pixelmon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixelmon/shared": "workspace:*",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "ioredis": "^5.4.1",
    "pg": "^8.13.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "tsup": "^8.3.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "eslint": "^9.16.0",
    "typescript-eslint": "^8.17.0"
  }

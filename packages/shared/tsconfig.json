{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
